<h1>Tablero en vivo</h1>
<p class="lede">Handlebars pinta la carga inicial. El socket actualiza el DOM.</p>

<form id="service-form" class="form">
  <label>Nombre <input name="name" required /></label>
  <label>Descripción <input name="description" required /></label>
  <label>Duración <input name="duration" type="number" required value="30" /></label>
  <label>Precio <input name="price" type="number" required value="18000" /></label>
  <label>Categoría <input name="category" required value="estetica" /></label>
  <button type="submit">Agregar</button>
</form>

<p id="form-error" class="error" hidden></p>

<ul id="services-list" class="grid">
  {{!-- Carga inicial: recorrer services --}}
</ul>


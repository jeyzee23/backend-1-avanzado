{
  "info": {
    "name": "Consultas Validacion Populate - Turnos",
    "description": "Sistema de Turnos. Ejecutar las carpetas en orden con Collection Runner. Solución: baseUrl http://localhost:8080; starter: http://localhost:8081. Las verificaciones de consultas, validación y populate deben pasar en la solución y sirven de objetivos para el starter. La ejecución crea dos servicios y una reserva de demostración. Para pruebas aisladas usar una instancia conectada a turnos_semana8_test.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "serviceId",
      "value": ""
    },
    {
      "key": "unavailableServiceId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 - Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Consultas buenas",
      "item": [
        {
          "name": "Listar servicios (defaults)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/services"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Paginacion consistente', () => { const b=pm.response.json(); pm.expect(b.payload).to.be.an('array'); pm.expect(b.payload.length).to.be.at.most(b.limit); pm.expect(b.totalPages).to.eql(Math.ceil(b.totalDocs/b.limit)); pm.expect(b.hasNextPage).to.eql(b.page < b.totalPages); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtrar category=salud y available=true",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/services?category=salud&available=true&page=1&limit=5&sortBy=price&order=asc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Paginacion consistente', () => { const b=pm.response.json(); pm.expect(b.payload).to.be.an('array'); pm.expect(b.payload.length).to.be.at.most(b.limit); pm.expect(b.totalPages).to.eql(Math.ceil(b.totalDocs/b.limit)); pm.expect(b.hasNextPage).to.eql(b.page < b.totalPages); });",
                  "pm.test('Filtro y precio ascendente', () => { const a=pm.response.json().payload; pm.expect(a.length).to.be.above(0); a.forEach((s,i)=>{pm.expect(s.category).to.eql('salud');pm.expect(s.available).to.eql(true);if(i)pm.expect(s.price).to.be.at.least(a[i-1].price);}); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtrar available=false",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/services?available=false"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Paginacion consistente', () => { const b=pm.response.json(); pm.expect(b.payload).to.be.an('array'); pm.expect(b.payload.length).to.be.at.most(b.limit); pm.expect(b.totalPages).to.eql(Math.ceil(b.totalDocs/b.limit)); pm.expect(b.hasNextPage).to.eql(b.page < b.totalPages); });",
                  "pm.test('Disponibilidad false', () => { const a=pm.response.json().payload; pm.expect(a.length).to.be.above(0); a.forEach(s=>pm.expect(s.available).to.eql(false)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Pagina 2 limit 3 sortBy=duration",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/services?page=2&limit=3&sortBy=duration&order=desc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Paginacion consistente', () => { const b=pm.response.json(); pm.expect(b.payload).to.be.an('array'); pm.expect(b.payload.length).to.be.at.most(b.limit); pm.expect(b.totalPages).to.eql(Math.ceil(b.totalDocs/b.limit)); pm.expect(b.hasNextPage).to.eql(b.page < b.totalPages); });",
                  "pm.test('Segunda pagina y duracion descendente', () => { const b=pm.response.json();pm.expect(b.page).to.eql(2);pm.expect(b.limit).to.eql(3);b.payload.forEach((s,i,a)=>{if(i)pm.expect(s.duration).to.be.at.most(a[i-1].duration);}); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Compatibilidad sort=desc (price)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/services?sort=desc&limit=5"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Paginacion consistente', () => { const b=pm.response.json(); pm.expect(b.payload).to.be.an('array'); pm.expect(b.payload.length).to.be.at.most(b.limit); pm.expect(b.totalPages).to.eql(Math.ceil(b.totalDocs/b.limit)); pm.expect(b.hasNextPage).to.eql(b.page < b.totalPages); });",
                  "pm.test('Precio descendente', () => pm.response.json().payload.forEach((s,i,a)=>{if(i)pm.expect(s.price).to.be.at.most(a[i-1].price);}));"
                ]
              }
            }
          ]
        }
      ]
    },

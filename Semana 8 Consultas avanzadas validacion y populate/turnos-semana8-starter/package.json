{
  "name": "turnos-semana8-starter",
  "version": "1.0.0",
  "description": "Turnos: consultas avanzadas, validación Zod y populate (starter de clase)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/scripts/seed.js",
    "test": "node --test --test-concurrency=1 test/validations.test.js test/queries.test.js test/routes.test.js"
